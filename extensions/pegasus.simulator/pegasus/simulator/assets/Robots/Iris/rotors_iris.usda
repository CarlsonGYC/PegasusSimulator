                            displayGroup = "Opacity"
                            displayName = "Enable Opacity"
                            doc = "Enables the use of cutout opacity"
                            hidden = false
                        )
                        bool inputs:enable_opacity_texture = 0 (
                            customData = {
                                bool default = 0
                            }
                            displayGroup = "Opacity"
                            displayName = "Enable Opacity Texture"
